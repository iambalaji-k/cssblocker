{
  "name": "CSS Blocker",
  "description": "Remove unwanted sections while browsing websites",
  "version": "1.0",
  "icons": {
    "16": "logo16.png",
    "48": "logo48.png",
    "128": "logo128.png"
  },
  "manifest_version": 2,
  "content_scripts": [
    {
      "matches": [
        "https://*.amazon.com.au/*",
        "https://*.amazon.com.br/*",
        "https://*.amazon.ca/*",
        "https://*.amazon.cn/*",
        "https://*.amazon.eg/*",
        "https://*.amazon.fr/*",
        "https://*.amazon.de/*",
        "https://*.amazon.in/*",
        "https://*.amazon.it/*",
        "https://*.amazon.co.jp/*",
        "https://*.amazon.com.mx/*",
        "https://*.amazon.nl/*",
        "https://*.amazon.pl/*",
        "https://*.amazon.sa/*",
        "https://*.amazon.sg/*",
        "https://*.amazon.es/*",
        "https://*.amazon.se/*",
        "https://*.amazon.com.tr/*",
        "https://*.amazon.ae/*",
        "https://*.amazon.co.uk/*",
        "https://*.amazon.com/*"
      ],
      "css": [
        "amazon.css"
      ]
    },
    {
      "matches": [
        "https://*.flipkart.com/*"
      ],
      "css": [
        "flipkart.css"
      ]
    },
    {
      "matches": [
        "https://*.hotstar.com/*"
      ],
      "css": [
        "hotstar.css"
      ]
    },
    {
      "matches": [
        "https://*.instagram.com/*"
      ],
      "css": [
        "instagram.css"
      ]
    },
    {
      "matches": [
        "https://*.x.com/*",
        "https://*.twitter.com/*"
      ],
      "css": [
        "x.css"
      ]
    },
    {
      "matches": [
        "https://*.crunchyroll.com/*"
      ],
      "css": [
        "crunchyroll.css"
      ]
    },
    {
      "matches": [
        "https://*.angelone.in/*"
      ],
      "css": [
        "angelone.css"
      ]
    },
    {
      "matches": [
        "https://*.icai.org/*"
      ],
      "css": [
        "icai.css"
      ]
    }
  ],
  "web_accessible_resources": []
}